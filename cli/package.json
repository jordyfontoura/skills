{
  "name": "@jordyfontoura/skills",
  "version": "0.2.0",
  "description": "Adoção guiada de skills e papéis de engenharia em português.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "skills": "dist/index.js" },
  "files": ["dist", "payload.json", "LICENSE"],
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/jordyfontoura/skills.git", "directory": "cli" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "python ../scripts/package_cli.py && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "bundle": "npm pack",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": { "@clack/prompts": "1.9.0" },
  "devDependencies": { "@types/node": "22.20.5", "typescript": "7.0.2" }
}
