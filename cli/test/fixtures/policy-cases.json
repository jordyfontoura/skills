{
  "base": {
    "version": 2,
    "profiles": { "default": { "candidates": [{ "provider": "inherit", "model": "inherit", "effort": "inherit" }] } },
    "roles": {
      "planner": { "when": "Planejar.", "profile": "default" },
      "evaluator": { "when": "Avaliar.", "profile": "default" },
      "representative": { "when": "Representar.", "profile": "default" },
      "council": { "when": "Consultar.", "profile": "default" }
    }
  },
  "cases": [
    { "name": "nome de perfil com quebra de linha", "valid": false, "changes": [{ "path": ["profiles", "custom\n"], "value": { "candidates": [{ "provider": "inherit", "model": "inherit", "effort": "inherit" }] } }] },
    { "name": "BOM em string não é espaço para o Python", "valid": true, "changes": [{ "path": ["roles", "planner", "when"], "value": "\ufeff" }] },
    { "name": "controle DEL precisa de escape TOML", "valid": true, "changes": [{ "path": ["roles", "planner", "when"], "value": "Planejar\u007f." }] },
    { "name": "U0085 é espaço para o Python", "valid": false, "changes": [{ "path": ["profiles", "default", "candidates", 0, "effort"], "value": "\u0085high" }] },
    { "name": "herança neutra", "valid": true, "changes": [] },
    { "name": "esforço explícito com modelo herdado", "valid": true, "changes": [{ "path": ["profiles", "default", "candidates", 0, "effort"], "value": "high" }] },
    { "name": "modelo e esforço de ambiente externo", "valid": true, "changes": [{ "path": ["profiles", "default", "candidates"], "value": [{ "provider": "custom-driver", "model": "local/model:v1", "effort": "custom-effort" }] }] },
    { "name": "alternativa concreta após herança", "valid": true, "changes": [{ "path": ["profiles", "default", "candidates"], "value": [{ "provider": "inherit", "model": "inherit", "effort": "inherit" }, { "provider": "other", "model": "model-b", "effort": "inherit" }] }] },
    { "name": "mapa de complexidade permitido", "valid": true, "changes": [{ "path": ["roles", "planner", "complexity"], "value": { "simple": "default", "hard": "default" } }] },
    { "name": "responsabilidade adicional", "valid": true, "changes": [{ "path": ["roles", "researcher"], "value": { "when": "Pesquisar.", "profile": "default", "complexity": {} } }] },
    { "name": "escape de strings TOML", "valid": true, "changes": [{ "path": ["roles", "planner", "when"], "value": "Planejar \"cenários\".\nCaminho C:\\projeto\t中文 🦊" }] },
    { "name": "versão desconhecida", "valid": false, "changes": [{ "path": ["version"], "value": 3 }] },
